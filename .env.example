# Local app URL. On Render/Railway, set this to the public HTTPS origin.
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development

# Sennin Account OAuth API
OAUTH_API_BASE_URL=https://sennin-account-api.xianrendesu.workers.dev
# Set this to the real authorization endpoint used by your Sennin Account deployment.
# The spec says the GAS URL is the user-facing entry point, but the exact authorize route
# and GAS redirect behavior must be verified in the live service.
OAUTH_AUTHORIZE_URL=https://script.google.com/macros/s/AKfycbzSlcCC1kI2TE63DqkhNACg9Bw8gVFs0Ca7loctMU_iiHThX8fnYC2FL_W4Vx70WESG/exec?endpoint=authorize
OAUTH_CLIENT_ID=replace_with_registered_client_id
OAUTH_CLIENT_SECRET=
OAUTH_CLIENT_AUTH_METHOD=client_secret_basic
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_SCOPES=profile email points:read
OAUTH_TOKEN_URL=https://sennin-account-api.xianrendesu.workers.dev/oauth/token
OAUTH_USERINFO_URL=https://sennin-account-api.xianrendesu.workers.dev/oauth/userinfo
OAUTH_POINTS_URL=https://sennin-account-api.xianrendesu.workers.dev/api/v1/points

# Use a long random value. Never commit a real .env file.
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Optional production session store. Recommended for multi-instance deployments.
# REDIS_URL=redis://default:password@host:port

# YouTube Data API v3 (optional; Invidious is fallback)
YOUTUBE_DATA_API_KEY=
YOUTUBE_INVIDIOUS_INSTANCES=https://inv.nboeck.de,https://yewtu.be,https://iv.ggtyler.dev

# Supabase chat (service role stays server-side; anon key is browser-safe)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
